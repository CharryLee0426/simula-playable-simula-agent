{
  "_doc": "Defaults for a session. Override in config/local.json (gitignored), with --set key=value, or with the CLI flags. README lists every field.",
  "budget_usd": 2.0,
  "models": {
    "planner": "google/gemini-4-hydrogen",
    "planner_reasoning": "low",
    "director": "google/gemini-4-hydrogen",
    "director_reasoning": "medium",
    "judge": "google/gemini-4-hydrogen",
    "decider": "perplexity/pplx-decider-v1.3:free"
  },
  "browser": {
    "viewport": [360, 640],
    "dpr": 2,
    "fps": 30,
    "display": "auto",
    "seed": 7
  },
  "play": {
    "max_game_s": 90,
    "min_game_s": 35,
