    "duration_s": 20,
    "max_source_s": 30,
    "max_speed": 1.5,
    "candidates": 3,
    "width": 1080,
    "height": 1920,
    "touch_overlay": true,
    "include_end_card": true
  },
  "index": {
    "decider_sample_s": 0.5,
    "decider_concurrency": 4
  },
  "eval": {
    "pairwise": true,
    "judge_samples": 2,
    "pass_score": 70
